# 이 파일은 예시입니다(시크릿 없음). 실제 값은 .env 또는 배포 플랫폼 환경변수에 넣으세요.

# 로컬 개발용 호스트 포트 (docker-compose.yml)
HOST_PORT=8080

# 프로덕션 도메인 (docker-compose.prod.yml + Caddy 자동 HTTPS 용)
DOMAIN=example.duckdns.org

# 결제: 포트원(PortOne) V2 — 포트원 콘솔에서 발급
#  - STORE_ID   : 상점 ID (store-xxxxxxxx-....)
#  - CHANNEL_KEY: 연동한 PG 채널 키 (channel-key-xxxxxxxx-....)
#  - API_SECRET : V2 API 시크릿 (서버 전용, 절대 프론트로 노출 금지)
# 세 값이 비어 있으면 앱은 '모의 결제(데모)' 모드로 동작한다.
PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_API_SECRET=xxxxxxxxxxxxxxxx
