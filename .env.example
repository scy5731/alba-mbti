# 이 파일은 예시입니다(시크릿 없음). 실제 값은 .env 또는 배포 플랫폼 환경변수에 넣으세요.

# 로컬 개발용 호스트 포트 (docker-compose.yml)
HOST_PORT=8080

# 프로덕션 도메인 (docker-compose.prod.yml + Caddy 자동 HTTPS 용)
DOMAIN=example.duckdns.org

# 나이스페이 (NICEPAY API V2 · 서버승인 모델)
# 두 개가 다 있어야 결제 기능이 켜진다. 비우면 앱은 전면 무료로 동작한다.
# clientId 접두사: S2_=샌드박스(테스트), R2_=실 운영(진짜 카드가 승인됨)
# NICEPAY_CLIENT_KEY=S2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NICEPAY_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 프리미엄 상세 리포트 판매가(원). 미설정 시 100원.
# PRICE_PREMIUM_REPORT=100

# 결제창이 돌아올 절대 주소(returnUrl 의 기준). 비우면 요청 헤더에서 유추.
# PUBLIC_BASE_URL=https://example.duckdns.org

# 계정 저장용 PostgreSQL (없으면 data/users.json 파일 저장으로 폴백)
# DATABASE_URL=postgres://user:pass@host:5432/alba

# 세션 쿠키 서명 키 (미설정 시 재시작마다 랜덤 → 로그인 풀림)
# SESSION_SECRET=아무-긴-랜덤-문자열

# 관리자 계정 — 이 이메일로 로그인하면 프로필에 '관리자' 메뉴가 열린다.
# 비워두면 관리자 기능은 완전히 닫힌다.
# ADMIN_EMAIL=you@example.com
