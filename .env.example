# 이 파일은 예시입니다(시크릿 없음). 실제 값은 .env 또는 배포 플랫폼 환경변수에 넣으세요.

# 로컬 개발용 호스트 포트 (docker-compose.yml)
HOST_PORT=8080

# 프로덕션 도메인 (docker-compose.prod.yml + Caddy 자동 HTTPS 용)
DOMAIN=example.duckdns.org

# 결제는 현재 없음(전면 무료). 도입 시 PG 키 환경변수를 여기에 다시 추가한다.

# 계정 저장용 PostgreSQL (없으면 data/users.json 파일 저장으로 폴백)
# DATABASE_URL=postgres://user:pass@host:5432/alba

# 세션 쿠키 서명 키 (미설정 시 재시작마다 랜덤 → 로그인 풀림)
# SESSION_SECRET=아무-긴-랜덤-문자열

# 관리자 계정 — 이 이메일로 로그인하면 프로필에 '관리자' 메뉴가 열린다.
# 비워두면 관리자 기능은 완전히 닫힌다.
# ADMIN_EMAIL=you@example.com
